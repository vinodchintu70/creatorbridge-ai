# ==============================================================================
# CreatorBridge AI — Production & Deployment Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development.
# In ByteXL Nimbus, configure these key-value pairs in the Environment Variables /
# Project Settings dashboard.
#
# SECURITY NOTICE:
# - NEVER commit real credentials, service-role keys, or .env.local to Git.
# - NEXT_PUBLIC_* variables are bundled into client-side JavaScript.
# - Variables without NEXT_PUBLIC_ remain strictly server-side.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION (Public / Client-Safe)
# ------------------------------------------------------------------------------
# Required for Supabase Auth, persistent database tables, and real-time messaging.
# Protected by Supabase Row Level Security (RLS) policies.
# Accessible in both client components and server route handlers.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-api-key-here

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI CONFIGURATION (Server-Only Secret)
# ------------------------------------------------------------------------------
# Required for AI Campaign Brief Copilot (/api/ai/generate-brief).
# Strictly executed on the Next.js server runtime — NEVER exposed to the browser.
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-google-gemini-api-key-here

# (Optional) Configured Gemini model. Defaults to 'gemini-3.7-flash' if omitted.
GEMINI_MODEL=gemini-3.7-flash
